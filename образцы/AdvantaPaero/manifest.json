{
  "manifest_version": 3,
  "name": "AdvantaPAero",
  "version": "1.7",
  "description": "Модульный инструментарий автоматизации Проект-Центра Конструкторского бюро",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["image001.jpg"],
      "matches": ["<all_urls>"]
    }
  ]
}